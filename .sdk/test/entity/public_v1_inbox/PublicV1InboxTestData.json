                },
                "type": "object"
              }
            }
          },
          "required": false
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "data": {
                      "properties": {
                        "inbox": {
                          "example": "test@ditube.info",
                          "type": "string"
                        },
                        "started_at": {
                          "example": "2026-03-04T10:00:00.000Z",
                          "format": "date-time",
                          "type": "string"
                        },
