# Entity: otp

main: kit: entity: otp: {

  alias: field: {}

  fields: [
    {
      name: "from"
      req: false
      type: "`$STRING`"
    }
    {
      name: "inbox"
      req: false
      type: "`$STRING`"
    }
    {
      name: "message"
      req: false
      type: "`$STRING`"
    }
    {
      name: "message_id"
      req: false
      type: "`$STRING`"
    }
    {
      name: "otp"
      req: false
      type: "`$STRING`"
    }
    {
      format: "date-time"
      name: "received_at"
      req: false
      type: "`$STRING`"
    }
    {
      format: "float"
      name: "score"
      req: false
      short: "Confidence score (0.0 to 1.0) of the extracted OTP."
      type: "`$NUMBER`"
