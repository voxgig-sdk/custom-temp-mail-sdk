# Entity: domain

main: kit: entity: domain: {

  alias: field: {}

  fields: [
    {
      name: "domain"
      req: true
      type: "`$STRING`"
    }
    {
      name: "expires_at"
      req: false
      type: "`$STRING`"
    }
    {
      name: "expires_in_days"
      req: false
      type: "`$INTEGER`"
    }
    {
      name: "expiring_soon"
      req: false
      type: "`$BOOLEAN`"
    }
    {
      name: "tags"
      req: true
      type: "`$ARRAY`"
    }
    {
      name: "tier"
      req: true
      type: "`$STRING`"
    }
  ]

  name: "domain"
  op: {
    list: {
      name: "list"
      points: [
        {
          method: "GET"
          orig: "/v1/domains"
          parts: [
            "v1"
            "domains"
          ]
          transform: {
            req: "`reqdata`"
            res: "`body.data`"
          }
        }
      ]
    }
  }



}
