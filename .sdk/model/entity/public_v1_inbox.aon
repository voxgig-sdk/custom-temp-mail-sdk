      type: "`$INTEGER`"
    }
    {
      format: "date-time"
      name: "started_at"
      req: false
      type: "`$STRING`"
    }
    {
      name: "success"
      req: false
      type: "`$BOOLEAN`"
    }
    {
      name: "test_id"
      req: false
      short: "Optional custom test ID."
      type: "`$STRING`"
    }
    {
      name: "username_style"
      req: false
