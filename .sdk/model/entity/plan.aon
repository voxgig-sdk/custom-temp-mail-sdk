# Entity: plan

main: kit: entity: plan: {

  alias: field: {}

  fields: [
    {
      name: "credit_packages"
      req: false
      type: "`$ARRAY`"
    }
    {
      name: "plans"
      req: false
      type: "`$ARRAY`"
    }
  ]

  name: "plan"
  op: {
    load: {
      name: "load"
      points: [
        {
          method: "GET"
          orig: "/v1/plans"
          parts: [
            "v1"
            "plans"
          ]
          transform: {
            req: "`reqdata`"
            res: "`body.data`"
          }
        }
      ]
    }
  }



}
