# Entity: usage

main: kit: entity: usage: {

  alias: field: {}

  fields: [
    {
      name: "credits"
      req: false
      type: "`$OBJECT`"
    }
    {
      name: "period"
      req: false
      type: "`$OBJECT`"
    }
    {
      name: "plan"
      req: false
      type: "`$STRING`"
    }
    {
      name: "rate_limit"
      req: false
      type: "`$OBJECT`"
    }
    {
      name: "requests"
      req: false
      type: "`$OBJECT`"
    }
  ]

  name: "usage"
  op: {
    load: {
      name: "load"
      points: [
        {
          method: "GET"
          orig: "/v1/usage"
          parts: [
            "v1"
            "usage"
          ]
          transform: {
            req: "`reqdata`"
            res: "`body.data`"
          }
        }
      ]
    }
  }



}
