# Entity: custom_domain

main: kit: entity: custom_domain: {

  alias: field: {}

  fields: [
    {
      name: "added_at"
      req: false
      type: "`$STRING`"
    }
    {
      name: "domain"
      req: true
      type: "`$STRING`"
    }
    {
      name: "mx_record"
      req: true
      type: "`$STRING`"
    }
    {
      name: "txt_record"
      req: true
      type: "`$STRING`"
    }
    {
      name: "verified"
      req: true
      type: "`$BOOLEAN`"
    }
  ]

  name: "custom_domain"
  op: {
    create: {
      name: "create"
      points: [
        {
          method: "POST"
          orig: "/v1/custom-domains"
          parts: [
            "v1"
            "custom-domains"
          ]
          transform: {
            req: "`reqdata`"
            res: "`body.data`"
          }
        }
      ]
    }
    list: {
      name: "list"
      points: [
        {
          method: "GET"
          orig: "/v1/custom-domains"
          parts: [
            "v1"
            "custom-domains"
          ]
          transform: {
            req: "`reqdata`"
            res: "`body.data`"
          }
        }
      ]
    }
    remove: {
      name: "remove"
      points: [
        {
          args: {
            params: [
              {
                example: "mail.acme.com"
                kind: "param"
                name: "id"
                orig: "domain"
                reqd: true
                type: "`$STRING`"
              }
            ]
          }
          method: "DELETE"
          orig: "/v1/custom-domains/{domain}"
          parts: [
            "v1"
            "custom-domains"
            "{id}"
          ]
          rename: {
            param: {
              domain: "id"
            }
          }
          select: {
            exist: [
              "id"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
