# Guide

guide: {
  metrics: count: entity: 14
  metrics: count: path: 21
  metrics: count: method: 25

  entity: custom_domain: {
    path: "/v1/custom-domains": {
      op: create: method: *POST
      op: list: method: *GET
    }
    path: "/v1/custom-domains/{domain}": {
      rename: param: "domain": *"id"
      op: remove: method: *DELETE
    }
  }

  entity: custom_domain_verify: {
    path: "/v1/custom-domains/{domain}/verify": {
      op: create: method: *POST
    }
  }

  entity: domain: {
    path: "/v1/domains": {
      op: list: method: *GET
    }
  }

  entity: domains_all: {
    path: "/v1/domains/all": {
      op: list: method: *GET
    }
  }

  entity: inbox: {
    path: "/v1/inboxes": {
      op: create: method: *POST
      op: load: method: *GET
    }
  }

  entity: men: {
    path: "/v1/me": {
      op: load: method: *GET
    }
  }

  entity: message: {
    path: "/v1/inboxes/{inbox}/messages": {
      rename: param: "inbox": *"inbox_id"
      op: load: method: *GET
    }
    path: "/v1/inboxes/{inbox}/messages/{id}": {
      rename: param: "inbox": *"inbox_id"
      op: load: method: *GET
    }
  }

  entity: otp: {
    path: "/v1/inboxes/{inbox}/otp": {
      rename: param: "inbox": *"inbox_id"
      op: load: method: *GET
    }
    path: "/v1/otp/public": {
      action: "public": {}
      op: load: method: *GET
    }
  }

  entity: plan: {
    path: "/v1/plans": {
      op: load: method: *GET
    }
  }

  entity: public_v1_dashboard_analytics: {
    path: "/v1/inboxes/{inbox}/insights": {
      rename: param: "inbox": *"inbox_id"
      op: load: method: *GET
    }
    path: "/v1/inboxes/{inbox}/timeline": {
      rename: param: "inbox": *"inbox_id"
      op: load: method: *GET
    }
  }

  entity: public_v1_inbox: {
    path: "/v1/inboxes/generate": {
      op: create: method: *POST
    }
    path: "/v1/inboxes/{inbox}": {
      rename: param: "inbox": *"id"
      op: remove: method: *DELETE
    }
    path: "/v1/inboxes/{inbox}/tests": {
      rename: param: "inbox": *"inbox_id"
      op: create: method: *POST
    }
  }

  entity: public_v1_message: {
    path: "/v1/inboxes/{inbox}/messages/{id}": {
      rename: param: "inbox": *"inbox_id"
      op: remove: method: *DELETE
    }
    path: "/v1/inboxes/{inbox}/wait": {
      rename: param: "inbox": *"inbox_id"
      op: load: method: *GET
    }
  }

  entity: public_v1_webhook: {
    path: "/v1/webhooks": {
      op: create: method: *POST
      op: list: method: *GET
    }
    path: "/v1/webhooks/{id}": {
      op: remove: method: *DELETE
    }
  }

  entity: usage: {
    path: "/v1/usage": {
      op: load: method: *GET
    }
  }

}