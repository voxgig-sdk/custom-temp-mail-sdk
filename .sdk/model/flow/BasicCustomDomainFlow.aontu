# BasicCustomDomainFlow

main: kit: flow: BasicCustomDomainFlow:
{
  entity: "custom_domain",
  kind: "basic",
  name: "BasicCustomDomainFlow",
  step: [
    {
      input: {
        ref: "custom_domain_ref01"
      }

      op: "create"
    }

    {
      op: "list",
      valid: [
        {
          apply: "ItemExists",
          def: {
            ref: "custom_domain_ref01"
          }
        }
      ]
    }

    {
      input: {
        ref: "custom_domain_ref01",
        suffix: "_rm0"
      }

      match: {
        id: "custom_domain01"
      }

      op: "remove"
    }

    {
      input: {
        suffix: "_rt0"
      }

      op: "list",
      valid: [
        {
          apply: "ItemNotExists",
          def: {
            ref: "custom_domain_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicCustomDomainFlow"
}