# BasicPublicV1InboxFlow

main: kit: flow: BasicPublicV1InboxFlow:
{
  entity: "public_v1_inbox",
  kind: "basic",
  name: "BasicPublicV1InboxFlow",
  step: [
    {
      input: {
        ref: "public_v1_inbox_ref01"
      }

      op: "create"
    }

    {
      input: {
        ref: "public_v1_inbox_ref01",
        suffix: "_rm0"
      }

      match: {
        id: "public_v1_inbox01"
      }

      op: "remove"
    }
  ],
  "key$": "BasicPublicV1InboxFlow"
}